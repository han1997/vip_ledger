<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      仅 debug 构建：允许明文 HTTP 访问走查用的 WebDAV 服务器。

      两个用途：
      - 模拟器里的 10.0.2.2 指向宿主机，宿主机上跑本地 WebDAV mock；
      - 局域网内的真实 WebDAV 服务器（NAS），地址随环境变化，按需追加。

      targetSdk 28 起平台默认禁止明文流量，没有这份配置就连不上；
      release 构建不含此文件，不受影响。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.10.4</domain>
    </domain-config>
</network-security-config>
