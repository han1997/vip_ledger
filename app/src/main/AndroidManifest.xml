<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 分期 / 信用卡到期提醒通知（API 33+ 需要运行时授权）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 语音记账（AI 页按住说话）：系统 SpeechRecognizer 需要麦克风，运行时按需申请。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 备份/恢复与（后续的）AI 联网；WorkManager 的「仅 Wi-Fi」约束需要读取网络状态。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ 包可见性：系统 SpeechRecognizer 需要查询可用 RecognitionService。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".VipLedgerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VipLedger">

        <service android:name=".autobook.PaymentNotificationService" android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <service android:name=".autobook.PaymentAccessibilityService" android:exported="true"
            android:label="@string/auto_channel" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/payment_accessibility" />
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VipLedger"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
